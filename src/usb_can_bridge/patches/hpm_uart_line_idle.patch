 	dma_start(data->dma_rx.dma_dev, data->dma_rx.channel);
@@ -988,9 +1065,9 @@ static void uart_hpm_dma_callback(const struct device *dev, void *arg, uint32_t
 			 * released，最后切换到 next buffer 并重新启动 DMA。
 			 */
