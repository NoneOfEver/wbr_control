/* The unused SIP PHY1 pads must not be driven by UART or DBUS GPIO. */
&uart4 { status = "disabled"; };
&uart6 { status = "disabled"; };

&esc0 {
	/* Only the four-wire SIP PHY0 is enabled for this bring-up. */
	nmii-link-ctrl-indices = <1 0>;
	nmii-link-inverted = <1 0>;
	nmii-link-from-io-mask = <1>;
};
